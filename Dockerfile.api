FROM node:22-slim

WORKDIR /app

# pnpm 9
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# monorepo 전체 복사
COPY . .

# workspace 의존성 설치
RUN pnpm install --frozen-lockfile

# API 빌드
RUN pnpm --filter api build

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

# API 실행
CMD ["pnpm", "--filter", "api", "start"]